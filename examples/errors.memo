# Deliberately broken, to show what the diagnostics look like.
#
#   MemoLang examples/errors.memo        (prints 4 errors, exits with code 1)

def missing_semicolon(int a) -> int {
    int b = a * 2
    return b;
}

def unknown_type(number x) {
    return x;
}

def bad_character() {
    int c = 3 $ 4;
}

def unclosed_string() {
    str s = "never closed;
}
