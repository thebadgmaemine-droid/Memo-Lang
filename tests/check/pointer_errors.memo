# Pointer type errors: one mistake, one error.

def address_of_rvalue(int a) {
    int* p = &3;                  # expect-error: 15: cannot take the address of this expression
}

def deref_non_pointer() {
    int x = 1;
    int y = *x;                   # expect-error: 13: can't dereference a value of type 'int'
}

def address_of_const() {
    const int c = 1;
    int* p = &c;                  # expect-error: 15: cannot take the address of constant 'c'
}

def wrong_pointee() {
    float f = 1.0;
    int* p = &f;                  # expect-error: 14: cannot initialize 'p' of type 'int*' with a value of type 'float*'
}

def no_pointer_math(int* p, int* q) {
    int* r = p + 1;               # expect-error: 14: invalid operands to '+': 'int*' and 'int'
    bool b = p < q;               # expect-error: 14: cannot compare 'int*' and 'int*' with '<'
}

def assign_through_pointer(int* p) {
    *p = "text";                  # expect-error: 10: cannot assign a value of type 'str' to the dereferenced pointer
}

def void_pointer(void* p) {       # expect-error: 18: can't point to 'void'
}

def escape_local() -> int* {
    int x = 1;
    return &x;                    # expect-error: 12: returning the address of local 'x' from 'escape_local'
}

def escape_param(int x) -> int* {
    return &x;                    # expect-error: 12: returning the address of local 'x' from 'escape_param'
}

int dummy_global = 0;
int* keep = &dummy_global;

def escape_to_global() {
    int x = 1;
    keep = &x;                    # expect-error: 12: global 'keep' can't hold the address of local 'x'
}

def pointer_cast(int* p) {
    int x = p as int;             # expect-error: 13: cannot cast 'int*' to 'int'
}
