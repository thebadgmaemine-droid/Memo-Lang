# u8, u16 and u32: wrap-around, comparisons and division stay unsigned.
# main() returns how many checks passed.
# expect-result: 10

def half(u32 x) -> u32 {
    return x // 2;
}

def main() -> int {
    int score = 0;
    u8 a = 255;
    a += 1;
    if a == 0 { score++; }                  # u8 wraps at 256
    u8 b = 0;
    b -= 1;
    if b == 255 { score++; }                # and below zero
    if b > 100 { score++; }                 # compares as unsigned
    u16 c = 65535;
    c += 2;
    if c == 1 { score++; }
    u32 d = 4294967295;
    if d > 0 { score++; }
    if d // 2 == 2147483647 { score++; }    # unsigned floor division
    if half(d) == 2147483647 { score++; }
    d += 1;
    if d == 0 { score++; }
    u32 e = 0;
    e -= 1;
    if e >> 31 == 1 { score++; }            # no sign bits shifted in
    byte f = 200;
    u8 g = f;                               # u8 is byte
    if g == 200 { score++; }
    return score;
}
